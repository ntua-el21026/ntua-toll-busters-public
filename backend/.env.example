# Copy to backend/.env and set private, local-only values.
DB_HOST=127.0.0.1
DB_USER=replace-with-local-app-user
DB_PASSWORD=replace-with-local-app-password
DB_NAME=toll_system
PORT=9115
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional one-time local admin initialization when running resetpasses.
ADMIN_BOOTSTRAP_PASSWORD=
