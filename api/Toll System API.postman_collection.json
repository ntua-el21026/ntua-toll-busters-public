		{
			"name": "https://localhost:9115/api/login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let responseJson = pm.response.json();\r",
							"if (responseJson.token) {\r",
							"    pm.globals.set(\"authToken\", responseJson.token);\r",
							"    pm.environment.set(\"authToken\", responseJson.token);\r",
							"    console.log(\"Saved token:\", responseJson.token);\r",
							"} else {\r",
							"    console.error(\"Login failed:\", responseJson);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "username",
							"value": "NO_operator",
							"type": "text"
						},
						{
							"key": "password",
							"value": "{{localOperatorPassword}}",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "https://localhost:9115/api/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "9115",
					"path": [
						"api",
						"login"
					]
				}
			},
			"response": []
		},
