	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"pm.sendRequest({\r",
					"    url: \"https://localhost:9115/api/auth/login\",  // Your login endpoint\r",
					"    method: \"POST\",\r",
					"    header: {\r",
					"        \"Content-Type\": \"application/x-www-form-urlencoded\"\r",
					"    },\r",
					"    body: {\r",
					"        mode: \"urlencoded\",\r",
					"        urlencoded: [\r",
					"            { key: \"username\", value: \"admin\" },  // Replace with actual credentials\r",
					"            { key: \"password\", value: \"freepasses4all\" }\r",
					"        ]\r",
					"    }\r",
					"}, function (err, response) {\r",
					"    if (!err && response.json().token) {\r",
					"        let token = response.json().token;  // Extract token from response\r",
					"        pm.globals.set(\"authToken\", token); // Store token globally\r",
					"        console.log(\"Token saved:\", token);\r",
					"    } else {\r",
					"        console.error(\"Login failed:\", err || response.text());\r",
					"    }\r",
					"});\r",
					""
				]
			}
		},
